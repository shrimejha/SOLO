# Git line-ending normalization
* text=auto

# Force LF for these file types
*.js      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.env*    text eol=lf
*.sh      text eol=lf

# Binary — no line-ending handling
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.mp4     binary
*.webm    binary
*.mov     binary
*.apk     binary
*.aab     binary
*.keystore binary
