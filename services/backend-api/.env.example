# Backend API — Environment Variables Template
# ------------------------------------------------
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.

# Server
PORT=4000

# Storage (MinIO / S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=solo-sessions
MINIO_USE_SSL=false

# Pipeline Worker
PIPELINE_WORKER_URL=http://localhost:5000
PIPELINE_SECRET_TOKEN=your_pipeline_token_here

# Optional: Cloud Storage (if using AWS S3 instead of MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
